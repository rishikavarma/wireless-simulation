+uint8_t
+NrMacSchedulerUeInfo::GetUlMcsForGrant() const
+{
+    return GetUlGrant().mcs;
+}
+
+NrAmc::McsParams
+NrMacSchedulerUeInfo::GetUlGrant() const
+{
+    NrAmc::McsParams grant;
+    grant.mcs = m_ulMcs;
+    grant.tbSize = m_ulRBG.empty() ? 0 : m_ulAmc->CalculateTbSize(
+        m_ulMcs, m_ulRank, m_ulRBG.size() * GetNumRbPerRbg());
+    if (!m_ulGrantPowerAwareMcs || !m_ulCqiSpectrumModel || m_ulCqi.m_timer == 0 ||
+        m_ulRBG.empty() || m_ulRank != 1)
+    {
+        return grant;
+    }
+    const auto bands = m_ulCqiSpectrumModel->GetNumBands();
+    std::set<uint32_t> active;
+    for (auto rbg : m_ulRBG)
+    {
+        for (uint32_t rb = rbg * GetNumRbPerRbg();
+             rb < std::min<uint32_t>((rbg + 1) * GetNumRbPerRbg(), bands); ++rb)
+        {
+            active.insert(rb);
+        }
+    }
+    if (active.empty())
+    {
+        return grant;
+    }
+    SpectrumValue predicted(m_ulCqiSpectrumModel);
+    for (auto rb : active)
+    {
+        predicted[rb] = m_ulTotalPowerSinr / active.size();
+    }
+    const auto mcs = m_ulAmc->GetMcsForSisoGrant(predicted, m_ulRBG.size() * GetNumRbPerRbg());
+    grant.mcs = mcs.value_or(0);
+    grant.tbSize = mcs ? m_ulAmc->CalculateTbSize(*mcs, 1,
+                                                 m_ulRBG.size() * GetNumRbPerRbg()) : 0;
+    return grant;
+}

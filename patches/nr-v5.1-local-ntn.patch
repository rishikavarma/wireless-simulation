+// Copyright (c) 2026
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include "ns3/nr-gnb-mac.h"
+#include "ns3/test.h"
+
+#include <functional>
+
+namespace ns3
+{
+namespace
+{
+/** RLC SAP double permitting exact control of per-call progress and overhead. */
+class GrantFillRlc : public NrMacSapUser
+{
+  public:
+    void NotifyTxOpportunity(TxOpportunityParameters params) override { m_send(params); }
+    void NotifyHarqDeliveryFailure() override {}
+    void ReceivePdu(ReceivePduParameters params) override {}
+    std::function<void(TxOpportunityParameters)> m_send; ///< Emission callback
+};
+} // namespace
+
+/** Enumerate budgets, short/long subheaders, empty queues, and multiple LCs. */
+class NrGnbMacGrantFillTestCase : public TestCase
+{
+  public:
+    NrGnbMacGrantFillTestCase() : TestCase("DL grant filling respects LC/TB budgets and stops without progress") {}
+
+  private:
+    void DoRun() override
+    {
+        auto mac = CreateObject<NrGnbMac>();
+        for (uint32_t budget = 0; budget <= 512; ++budget)
+        {
+            for (uint32_t cap : {0u, 4u, 5u, 124u, 127u, 128u, 240u, 1024u})
+            {
+                const uint32_t initial = budget % 31;
+                uint32_t used = initial;
+                uint32_t calls = 0;
+                GrantFillRlc rlc;
+                rlc.m_send = [&](NrMacSapUser::TxOpportunityParameters params) {
+                    ++calls;
+                    NS_TEST_ASSERT_MSG_EQ(params.lcid, 3, "LC identity retained");
+                    NS_TEST_ASSERT_MSG_EQ(params.harqId, 2, "HARQ identity retained");
+                    const uint32_t bytes = std::min(cap, params.bytes);
+                    if (bytes > 0) used += bytes + (bytes > 127 ? 3 : 2);
+                };
+                auto params = NrMacSapUser::TxOpportunityParameters(budget, 0, 2, 0, 1, 3);
+                mac->FillDlTxOpportunity(&rlc, params, used, initial + budget + 3);
+                NS_TEST_ASSERT_MSG_LT_OR_EQ(used, initial + budget + 3, "LC budget bounds all headers");
+                NS_TEST_ASSERT_MSG_LT_OR_EQ(calls, budget + 1, "bounded calls");
+                if (cap == 0 && budget > 0)
+                    NS_TEST_ASSERT_MSG_EQ(calls, 1, "zero progress exits immediately");
+                if (cap > 0 && budget > 0)
+                    NS_TEST_ASSERT_MSG_LT_OR_EQ(initial + budget + 3 - used, 3,
+                                               "available capacity filled up to header slack");
+            }
+        }
+        // First LC has a larger nominal offer than the remaining TB; the next LC
+        // must not spend capacity already used by the first.
+        uint32_t used = 0;
+        GrantFillRlc rlc;
+        rlc.m_send = [&](NrMacSapUser::TxOpportunityParameters params) {
+            const uint32_t bytes = std::min(124u, params.bytes);
+            used += bytes + (bytes > 127 ? 3 : 2);
+        };
+        auto params = NrMacSapUser::TxOpportunityParameters(5000, 0, 2, 0, 1, 3);
+        mac->FillDlTxOpportunity(&rlc, params, used, 2515);
+        const uint32_t before = used;
+        mac->FillDlTxOpportunity(&rlc, params, used, 2515);
+        NS_TEST_ASSERT_MSG_LT_OR_EQ(used, 2515, "transport block cannot overflow");
+        NS_TEST_ASSERT_MSG_EQ(used, before, "remaining header slack cannot form another PDU");
+        NS_TEST_ASSERT_MSG_GT(used, 2400, "120-byte RLC payload cap no longer leaves TB empty");
+        mac->Dispose();
+    }
+};
+
+/** DL multiplexing regression suite. */
+class NrGnbMacGrantFillTestSuite : public TestSuite
+{
+  public:
+    NrGnbMacGrantFillTestSuite() : TestSuite("nr-gnb-mac-grant-fill", Type::UNIT)
+    {
+        AddTestCase(new NrGnbMacGrantFillTestCase(), Duration::QUICK);
+    }
+};
+static NrGnbMacGrantFillTestSuite g_nrGnbMacGrantFillTestSuite;
+} // namespace ns3

+bool
+NrSpectrumPhy::DeferNtnBoundaryRx(Ptr<const SpectrumSignalParameters> params, State incoming,
+                                  Time duration)
+{
+    if (m_ntnBoundaryTolerance.IsZero() || m_state == incoming ||
+        (m_state != RX_DATA && m_state != RX_DL_CTRL && m_state != RX_UL_CTRL && m_state != RX_UL_SRS))
+    {
+        return false;
+    }
+    const Time remaining = m_ntnRxWindowEnd - Simulator::Now();
+    const Time wait = remaining + NanoSeconds(1);
+    if (remaining.IsStrictlyNegative() || remaining > m_ntnBoundaryTolerance || duration <= wait)
+    {
+        return false; // Preserve the original error handling for larger scheduling errors.
+    }
+    // StartRx already registered params in m_allSignalsMimo. MIMO covariance
+    // excludes desired signals by object identity, so a copy here would be
+    // counted as an external interferer against its own original signal.
+    // Shorten only the receiver window and retain that original identity.
+    ++m_ntnBoundaryAdjustments;
+    m_ntnBoundaryTrace(remaining);
+    Simulator::Schedule(wait, &NrSpectrumPhy::RetryNtnBoundaryRx, this, params, incoming,
+                        duration - wait);
+    return true;
+}
+
+void
+NrSpectrumPhy::RetryNtnBoundaryRx(Ptr<const SpectrumSignalParameters> params, State incoming,
+                                  Time duration)
+{
+    // Receive handlers do not mutate signal parameters; the cast preserves
+    // their existing interface while retaining the registered object itself.
+    auto signal = ConstCast<SpectrumSignalParameters>(params);
+    switch (incoming)
+    {
+    case RX_DATA:
+        StartRxData(DynamicCast<NrSpectrumSignalParametersDataFrame>(signal), duration);
+        break;
+    case RX_DL_CTRL:
+        StartRxDlCtrl(DynamicCast<NrSpectrumSignalParametersDlCtrlFrame>(signal), duration);
+        break;
+    case RX_UL_CTRL:
+        StartRxUlCtrl(DynamicCast<NrSpectrumSignalParametersUlCtrlFrame>(signal), duration);
+        break;
+    case RX_UL_SRS:
+        StartRxSrs(DynamicCast<NrSpectrumSignalParametersUlCtrlFrame>(signal), duration);
+        break;
+    default:
+        NS_FATAL_ERROR("Unexpected deferred NTN reception type");
+    }
+}

+/** Grant-width changes must not reuse narrow-grant power in a wide grant. */
+class NrUlGrantPowerTestCase : public TestCase
+{
+  public:
+    NrUlGrantPowerTestCase() : TestCase("UL full-grant MCS is independent of observed allocation width") {}
+
+  private:
+    void AllocationTests(Ptr<const SpectrumModel> model, Ptr<NrAmc> amc, Ptr<NrLteMiErrorModel> error);
+    void DoRun() override
+    {
+        Bands bands;
+        for (uint32_t rb = 0; rb < 53; ++rb)
+        {
+            const double fc = 2e9 + rb * 180000;
+            bands.push_back({fc - 90000, fc, fc + 90000});
+        }
+        auto model = Create<SpectrumModel>(bands);
+        auto amc = CreateObject<NrAmc>();
+        amc->SetUlMode();
+        auto error = CreateObject<NrLteMiErrorModel>();
+        auto ue = std::make_shared<NrMacSchedulerUeInfoRR>(1, BeamId(0, 0), [] { return 1; });
+        ue->m_ulAmc = amc;
+        ue->m_ulMcs = 22;
+        ue->m_ulGrantPowerAwareMcs = true;
+        NrMacSchedulerCQIManagement cqi;
+        cqi.InstallGetNrAmcUlFn([amc] { return amc; });
+        cqi.InstallGetStartMcsUlFn([] { return 0; });
+        uint32_t checked = 0;
+        for (double totalSinr : {0.1, 3.0, 30.0, 300.0, 3000.0})
+        {
+            std::vector<uint8_t> reference;
+            for (uint32_t observed : {1u, 3u, 7u, 30u, 53u})
+            {
+                uint32_t transition = 0;
+                NrMacSchedSapProvider::SchedUlCqiInfoReqParameters report{};
+                report.m_ulCqi.m_sinr.assign(53, 0);
+                std::vector<bool> mask(53, false);
+                for (uint32_t rb = 0; rb < observed; ++rb)
+                {
+                    report.m_ulCqi.m_sinr[rb] = totalSinr / observed;
+                    mask[rb] = true;
+                }
+                cqi.UlSBCQIReported(100, 100, report, ue, mask, 1, model);
+                NS_TEST_ASSERT_MSG_EQ_TOL(ue->m_ulTotalPowerSinr, totalSinr, 1e-9,
+                                          "allocation-normalized observation");
+                for (uint32_t width = 1; width <= 53; ++width)
+                {
+                    for (uint32_t symbols : {1u, 7u, 13u})
+                    {
+                        ue->m_ulRBG.clear();
+                        SpectrumValue predicted(model);
+                        std::vector<int> active;
+                        // Shift the mask to exercise RBs absent from the observation.
+                        for (uint32_t rb = 53 - width; rb < 53; ++rb)
+                        {
+                            predicted[rb] = totalSinr / width;
+                            active.push_back(rb);
+                            for (uint32_t s = 0; s < symbols; ++s) ue->m_ulRBG.push_back(rb);
+                        }
+                        const auto grant = ue->GetUlGrant();
+                        const auto selected = grant.mcs;
+                        if (totalSinr == 30 && symbols == 13 && width == 1)
+                            NS_TEST_ASSERT_MSG_GT(selected, 15, "narrow high-SINR grants use efficient modulation");
+                        if (totalSinr == 30 && symbols == 13 && width == 30)
+                            NS_TEST_ASSERT_MSG_LT(selected, 10, "wide grant cannot reuse narrow-grant MCS 22");
+                        ue->UpdateUlMetric();
+                        const auto bytes = grant.tbSize;
+                        NS_TEST_ASSERT_MSG_EQ(ue->m_ulTbSize, bytes, "allocation metric uses grant MCS");
+                        if (bytes > 0)
+                        {
+                            auto result = error->GetTbDecodificationStats(predicted, active, bytes, selected, {});
+                            NS_TEST_ASSERT_MSG_LT_OR_EQ(result->m_tbler, 0.1,
+                                                       "selected full TB meets target if feasible");
+                        }
+                        // Changing only the observed width must not alter the
+                        // decision for the same future physical grant.
+                        if (observed == 1)
+                        {
+                            reference.push_back(selected);
+                        }
+                        else
+                        {
+                            NS_TEST_ASSERT_MSG_EQ(selected, reference.at(transition),
+                                                  "past grant width does not bias future MCS");
+                        }
+                        ++transition;
+                        ++checked;
+                    }
+                }
+            }
+        }
+        NS_TEST_ASSERT_MSG_EQ(checked, 3975, "grant transition coverage");
+        ue->m_ulMcs = 17;
+        ue->m_ulCqi.m_timer = 0;
+        NS_TEST_ASSERT_MSG_EQ(ue->GetUlMcsForGrant(), 17, "expired CQI never supplies a prediction");
+        std::unordered_map<uint16_t, std::shared_ptr<NrMacSchedulerUeInfo>> ues{{1, ue}};
+        cqi.RefreshUlCqiMaps(ues);
+        NS_TEST_ASSERT_MSG_EQ(ue->GetUlMcsForGrant(), 0, "expiry restores starting MCS");
+        ue->m_ulCqi.m_timer = 10;
+        ue->m_ulGrantPowerAwareMcs = false;
+        ue->m_ulMcs = 11;
+        NS_TEST_ASSERT_MSG_EQ(ue->GetUlMcsForGrant(), 11, "disabled correction preserves configured MCS");
+        ue->m_ulGrantPowerAwareMcs = true;
+        ue->m_ulRBG.clear();
+        NS_TEST_ASSERT_MSG_EQ(ue->GetUlMcsForGrant(), 11, "no grant retains cached MCS");
+        ue->m_ulRBG.assign(13, 0);
+        ue->m_ulTotalPowerSinr = 0;
+        NS_TEST_ASSERT_MSG_EQ(ue->GetUlMcsForGrant(), 0, "deep fade cannot reuse high MCS");
+        // Two RBs per RBG, repeated across symbols. The final observed RBG is
+        // partial; CQI bookkeeping must not read beyond the 53-RB spectrum.
+        auto grouped = std::make_shared<NrMacSchedulerUeInfoRR>(2, BeamId(0, 0), [] { return 2; });
+        grouped->m_ulAmc = amc;
+        grouped->m_ulGrantPowerAwareMcs = true;
+        NrMacSchedSapProvider::SchedUlCqiInfoReqParameters report{};
+        report.m_ulCqi.m_sinr.assign(53, 30.0 / 53);
+        cqi.UlSBCQIReported(100, 100, report, grouped, std::vector<bool>(27, true), 2, model);
+        NS_TEST_ASSERT_MSG_EQ_TOL(grouped->m_ulTotalPowerSinr, 30, 1e-9, "partial source RBG bounded");
+        grouped->m_ulRBG = {2, 2, 2, 5, 5, 5};
+        SpectrumValue physical(model);
+        std::vector<int> map{4, 5, 10, 11};
+        for (auto rb : map) physical[rb] = 7.5;
+        const auto selected = grouped->GetUlMcsForGrant();
+        const auto bytes = amc->CalculateTbSize(selected, 1, 12);
+        auto result = error->GetTbDecodificationStats(physical, map, bytes, selected, {});
+        NS_TEST_ASSERT_MSG_LT_OR_EQ(result->m_tbler, 0.1, "RBG repetitions do not dilute per-RB power");
+        AllocationTests(model, amc, error);
+        amc->Dispose();
+        error->Dispose();
+    }
+};

+
+void
+NrUlGrantPowerTestCase::AllocationTests(Ptr<const SpectrumModel> model, Ptr<NrAmc> amc,
+                                       Ptr<NrLteMiErrorModel> error)
+{
+    auto scheduler = CreateObject<GrantBudgetScheduler>();
+    GrantCschedSapUser csap;
+    GrantSchedSapUser sap;
+    scheduler->SetMacCschedSapUser(&csap);
+    scheduler->SetMacSchedSapUser(&sap);
+    scheduler->InstallUlAmc(amc);
+    NrMacCschedSapProvider::CschedCellConfigReqParameters cell{};
+    cell.m_dlBandwidth = 53;
+    cell.m_ulBandwidth = 53;
+    scheduler->GetMacCschedSapProvider()->CschedCellConfigReq(cell);
+    const BeamId beam(0, 0);
+    for (uint32_t backlog : {1u, 10u, 1000000u})
+    for (const auto& powers : {std::vector<double>{3.0}, std::vector<double>{3.0, 3000.0},
+                               std::vector<double>{0.0, 3000.0}, std::vector<double>{0.0}})
+    {
+        NrMacSchedulerNs3::ActiveUeMap active;
+        std::vector<std::shared_ptr<NrMacSchedulerUeInfoRR>> ues;
+        uint16_t rnti = 1;
+        for (auto power : powers)
+        {
+            auto ue = std::make_shared<NrMacSchedulerUeInfoRR>(rnti++, beam, [] { return 1; });
+            ue->m_ulAmc = amc;
+            ue->m_ulGrantPowerAwareMcs = true;
+            ue->m_ulTotalPowerSinr = power;
+            ue->m_ulCqiSpectrumModel = model;
+            ue->m_ulCqi.m_timer = 100;
+            active[beam].push_back({ue, backlog});
+            ues.push_back(ue);
+        }
+        const auto symbols = scheduler->AssignULRBG(13, active);
+        NrMacSchedulerNs3::PointInFTPlane point(0, 13);
+        std::set<uint32_t> assigned;
+        for (auto ue : ues)
+        {
+            if (ue->m_ulRBG.empty())
+            {
+                NS_TEST_ASSERT_MSG_EQ(ue->m_ulTotalPowerSinr, 0, "only an outage UE is deferred");
+                continue;
+            }
+            const auto dci = scheduler->CreateUlDci(&point, ue, symbols.at(beam));
+            NS_TEST_ASSERT_MSG_NE(dci, nullptr, "a usable allocation creates a DCI");
+            NS_TEST_ASSERT_MSG_GT_OR_EQ(dci->m_tbSize, 15,
+                                       "grant fits BSR, MAC header and minimum RLC opportunity");
+            std::vector<int> rbMap;
+            SpectrumValue sinr(model);
+            for (uint32_t rb = 0; rb < dci->m_rbgBitmask.size(); ++rb)
+            {
+                if (dci->m_rbgBitmask[rb])
+                {
+                    NS_TEST_ASSERT_MSG_EQ(assigned.insert(rb).second, true, "UE grants do not overlap");
+                    rbMap.push_back(rb);
+                }
+            }
+            for (auto rb : rbMap) sinr[rb] = ue->m_ulTotalPowerSinr / rbMap.size();
+            auto result = error->GetTbDecodificationStats(sinr, rbMap, dci->m_tbSize, dci->m_mcs, {});
+            NS_TEST_ASSERT_MSG_LT_OR_EQ(result->m_tbler, 0.1, "actual emitted DCI meets power budget");
+            NS_TEST_ASSERT_MSG_EQ(dci->m_tbSize, ue->m_ulTbSize, "metric and emitted grant agree");
+            if (ue->m_ulTotalPowerSinr == 3)
+                NS_TEST_ASSERT_MSG_LT(rbMap.size(), 53, "power-limited UE retains a narrower feasible grant");
+        }
+        if (powers.size() == 2 && backlog == 1000000)
+            NS_TEST_ASSERT_MSG_EQ(assigned.size(), 53, "resources refused by weak UE remain available to strong UE");
+    }
+    scheduler->Dispose();
+    Simulator::Destroy();
+}

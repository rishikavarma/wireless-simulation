+Ptr<Packet>
+NrRlcAm::MakeFragment(Ptr<const Packet> original, uint32_t begin, uint32_t end, bool poll) const
+{
+    auto payload = original->Copy();
+    NrRlcAmHeader source;
+    payload->RemoveHeader(source);
+    NS_ASSERT(begin < end && end <= payload->GetSize() && begin <= 0x7fff);
+    std::set<uint32_t> boundaries;
+    if (!(source.GetFramingInfo() & NrRlcAmHeader::NO_FIRST_BYTE))
+    {
+        boundaries.insert(0);
+    }
+    uint32_t offset = 0;
+    while (source.PopExtensionBit() == NrRlcAmHeader::E_LI_FIELDS_FOLLOWS)
+    {
+        offset += source.PopLengthIndicator();
+        boundaries.insert(offset);
+    }
+    if (!(source.GetFramingInfo() & NrRlcAmHeader::NO_LAST_BYTE))
+    {
+        boundaries.insert(payload->GetSize());
+    }
+    NrRlcAmHeader header;
+    header.SetDataPdu();
+    header.SetSequenceNumber(source.GetSequenceNumber());
+    header.SetResegmentationFlag(begin == 0 && end == payload->GetSize()
+                                    ? NrRlcAmHeader::PDU : NrRlcAmHeader::SEGMENT);
+    header.SetSegmentOffset(begin);
+    header.SetLastSegmentFlag(end == payload->GetSize());
+    header.SetPollingBit(poll);
+    header.SetFramingInfo((boundaries.contains(begin) ? 0 : NrRlcAmHeader::NO_FIRST_BYTE) |
+                         (boundaries.contains(end) ? 0 : NrRlcAmHeader::NO_LAST_BYTE));
+    uint32_t previous = begin;
+    for (auto boundary : boundaries)
+    {
+        if (begin < boundary && boundary < end)
+        {
+            header.PushExtensionBit(NrRlcAmHeader::E_LI_FIELDS_FOLLOWS);
+            header.PushLengthIndicator(boundary - previous);
+            previous = boundary;
+        }
+    }
+    header.PushExtensionBit(NrRlcAmHeader::DATA_FIELD_FOLLOWS);
+    auto result = payload->CreateFragment(begin, end - begin);
+    result->AddHeader(header);
+    NrRlcTag tag(Simulator::Now());
+    tag.SetTxEntityId(m_rlcEntityId);
+    result->AddByteTag(tag, 1, header.GetSerializedSize());
+    return result;
+}
+
+void
+NrRlcAm::QueueRetransmission(uint16_t sn, const std::vector<ByteRange>& ranges)
+{
+    auto& pending = m_retxBuffer.at(sn);
+    auto& awaiting = m_txedBuffer.at(sn);
+    auto original = pending.m_pdu ? pending.m_pdu : awaiting.m_pdu;
+    if (!original)
+    {
+        return; // A late NACK cannot resurrect an acknowledged sequence number.
+    }
+    auto payload = original->Copy();
+    NrRlcAmHeader header;
+    payload->RemoveHeader(header);
+    std::vector<ByteRange> requested;
+    for (auto [begin, end] : ranges)
+    {
+        end = std::min(end, payload->GetSize());
+        if (begin < end)
+        {
+            requested.emplace_back(begin, end);
+        }
+    }
+    if (requested.empty())
+    {
+        return;
+    }
+    if (!pending.m_pdu)
+    {
+        pending = awaiting;
+        awaiting = {};
+        m_txedBufferSize -= original->GetSize();
+        m_retxBufferSize += original->GetSize();
+        if (pending.m_retransmitted)
+        {
+            ++pending.m_retxCount;
+        }
+        pending.m_retransmitted = true;
+        if (pending.m_retxCount >= m_maxRetxThreshold && !m_maxRetxReachedNotified &&
+            !m_maxRetxReachedCallback.IsNull())
+        {
+            m_maxRetxReachedNotified = true;
+            auto callback = m_maxRetxReachedCallback;
+            Simulator::ScheduleNow([callback]() { callback(); });
+        }
+    }
+    requested.insert(requested.end(), pending.m_pending.begin(), pending.m_pending.end());
+    std::sort(requested.begin(), requested.end());
+    pending.m_pending.clear();
+    for (const auto& range : requested)
+    {
+        if (!pending.m_pending.empty() && range.first <= pending.m_pending.back().second)
+        {
+            pending.m_pending.back().second = std::max(pending.m_pending.back().second, range.second);
+        }
+        else
+        {
+            pending.m_pending.push_back(range);
+        }
+    }
+}
+
+std::vector<NrRlcAm::ByteRange>
+NrRlcAm::GetMissingRanges(uint16_t sn) const
+{
+    auto found = m_rxonBuffer.find(sn);
+    if (found == m_rxonBuffer.end())
+    {
+        return {{0, 32768}};
+    }
+    const auto& received = found->second;
+    if (received.m_pduComplete)
+    {
+        return {};
+    }
+    std::vector<ByteRange> result;
+    uint32_t next = 0;
+    for (const auto& [offset, payload] : received.m_fragments)
+    {
+        if (next < offset)
+        {
+            result.emplace_back(next, offset);
+        }
+        next = offset + payload->GetSize();
+    }
+    const uint32_t end = received.m_end.value_or(32768);
+    if (next < end)
+    {
+        result.emplace_back(next, end);
+    }
+    return result;
+}
+
+bool
+NrRlcAm::ReceiveSegment(Ptr<Packet> packet, const NrRlcAmHeader& header)
+{
+    auto payload = packet->Copy();
+    NrRlcAmHeader parsed;
+    payload->RemoveHeader(parsed);
+    const bool segmented = header.GetResegmentationFlag() == NrRlcAmHeader::SEGMENT;
+    const uint32_t begin = segmented ? header.GetSegmentOffset() : 0;
+    const uint32_t end = begin + payload->GetSize();
+    const bool last = !segmented || header.GetLastSegmentFlag();
+    if (payload->GetSize() == 0 || end > 32768)
+    {
+        return false;
+    }
+    std::set<uint32_t> boundaries;
+    uint32_t offset = begin;
+    while (parsed.PopExtensionBit() == NrRlcAmHeader::E_LI_FIELDS_FOLLOWS)
+    {
+        const uint32_t length = parsed.PopLengthIndicator();
+        offset += length;
+        if (length == 0 || offset >= end)
+        {
+            return false;
+        }
+        boundaries.insert(offset);
+    }
+    if (!(header.GetFramingInfo() & NrRlcAmHeader::NO_FIRST_BYTE))
+    {
+        boundaries.insert(begin);
+    }
+    if (!(header.GetFramingInfo() & NrRlcAmHeader::NO_LAST_BYTE))
+    {
+        boundaries.insert(end);
+    }
+    auto& received = m_rxonBuffer[header.GetSequenceNumber().GetValue()];
+    if (received.m_pduComplete || (received.m_end &&
+        (end > *received.m_end || (last && end != *received.m_end))))
+    {
+        return false;
+    }
+    if (last && !received.m_fragments.empty())
+    {
+        auto tail = received.m_fragments.rbegin();
+        if (tail->first + tail->second->GetSize() > end)
+        {
+            return false;
+        }
+    }
+    received.m_seqNumber = header.GetSequenceNumber();
+    if (last)
+    {
+        received.m_end = end;
+    }
+    if (begin == 0)
+    {
+        received.m_firstByte = !(header.GetFramingInfo() & NrRlcAmHeader::NO_FIRST_BYTE);
+    }
+    received.m_boundaries.insert(boundaries.begin(), boundaries.end());
+    std::vector<ByteRange> newRanges;
+    uint32_t cursor = begin;
+    for (const auto& [start, part] : received.m_fragments)
+    {
+        if (start >= end)
+        {
+            break;
+        }
+        if (start > cursor)
+        {
+            newRanges.emplace_back(cursor, start);
+        }
+        cursor = std::max(cursor, start + part->GetSize());
+    }
+    if (cursor < end)
+    {
+        newRanges.emplace_back(cursor, end);
+    }
+    for (const auto& [start, stop] : newRanges)
+    {
+        received.m_fragments.emplace(start, payload->CreateFragment(start - begin, stop - start));
+    }
+    if (!received.m_end || !GetMissingRanges(header.GetSequenceNumber().GetValue()).empty())
+    {
+        return !newRanges.empty();
+    }
+    auto complete = Create<Packet>();
+    for (const auto& [start, part] : received.m_fragments)
+    {
+        complete->AddAtEnd(part);
+    }
+    NrRlcAmHeader assembled;
+    assembled.SetDataPdu();
+    assembled.SetSequenceNumber(header.GetSequenceNumber());
+    assembled.SetResegmentationFlag(NrRlcAmHeader::PDU);
+    assembled.SetSegmentOffset(0);
+    assembled.SetLastSegmentFlag(NrRlcAmHeader::LAST_PDU_SEGMENT);
+    assembled.SetPollingBit(header.GetPollingBit());
+    assembled.SetFramingInfo((received.m_firstByte ? 0 : NrRlcAmHeader::NO_FIRST_BYTE) |
+                            (received.m_boundaries.contains(*received.m_end)
+                                 ? 0 : NrRlcAmHeader::NO_LAST_BYTE));
+    uint32_t previous = 0;
+    for (auto boundary : received.m_boundaries)
+    {
+        if (boundary > 0 && boundary < *received.m_end)
+        {
+            assembled.PushExtensionBit(NrRlcAmHeader::E_LI_FIELDS_FOLLOWS);
+            assembled.PushLengthIndicator(boundary - previous);
+            previous = boundary;
+        }
+    }
+    assembled.PushExtensionBit(NrRlcAmHeader::DATA_FIELD_FOLLOWS);
+    complete->AddHeader(assembled);
+    // The reconstructed header must retain the receive-side entity/timing tag.
+    // Payload slices no longer contain the individual segment header tags.
+    NrRlcTag tag;
+    const bool tagged = packet->FindFirstMatchingByteTag(tag);
+    NS_ASSERT_MSG(tagged, "Received AM segment has no RLC tag");
+    complete->AddByteTag(tag, 1, assembled.GetSerializedSize());
+    received.m_byteSegments = {complete};
+    received.m_pduComplete = true;
+    received.m_fragments.clear();
+    return true;
+}

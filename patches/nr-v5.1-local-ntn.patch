diff --git a/test/nr-connected-ra-test.cc b/test/nr-connected-ra-test.cc
new file mode 100644
index 0000000..abc9b0d
--- /dev/null
+++ b/test/nr-connected-ra-test.cc
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "ns3/nr-gnb-mac.h"
+#include "ns3/nr-ue-mac.h"
+#include "ns3/nr-control-messages.h"
+#include "ns3/nr-mac-header-fs-ul.h"
+#include "ns3/nr-radio-bearer-tag.h"
+#include "ns3/beam-id.h"
+#include "ns3/simulator.h"
+#include "ns3/test.h"
+
+namespace ns3
+{
+/** PHY peer retaining the actual Msg3 bytes and transmission identity. */
+class ConnectedRaPhy : public NrPhySapProvider
+{
+  public:
+    void SendMacPdu(const Ptr<Packet>& p, const SfnSf&, uint8_t, uint16_t rnti) override
+    { packet=p->Copy(); identity=rnti; }
+    void SendControlMessage(Ptr<NrControlMessage>) override {}
+    void SendRachPreamble(uint8_t, uint8_t) override {}
+    void SetSlotAllocInfo(const SlotAllocInfo&) override {}
+    void NotifyConnectionSuccessful() override {}
+    BeamId GetBeamId(uint8_t) const override { return BeamId(0,0); }
+    Ptr<const SpectrumModel> GetSpectrumModel() override { return nullptr; }
+    uint16_t GetBwpId() const override { return 0; }
+    uint16_t GetCellId() const override { return 1; }
+    uint32_t GetSymbolsPerSlot() const override { return 14; }
+    Time GetSlotPeriod() const override { return MilliSeconds(1); }
+    uint32_t GetRbNum() const override { return 53; }
+    void RegisterToGnb(uint16_t) override {}
+    uint32_t GetArfcn() const override { return 0; }
+    Ptr<Packet> packet; ///< Captured physical Msg3 PDU.
+    uint16_t identity{0}; ///< Physical transmission uses the temporary identity.
+};
+
+/** RRC peer counting actual successful access notifications. */
+class ConnectedRaRrc : public NrUeCmacSapUser
+{
+  public:
+    void SetTemporaryCellRnti(uint16_t) override { ++replacements; }
+    void NotifyRandomAccessSuccessful() override { ++successes; }
+    void NotifyRandomAccessFailed() override { ++failures; }
+    unsigned replacements{0}, successes{0}, failures{0}; ///< Callback counts.
+};
+
+/** Connected access preserves bearers and resolves only after an addressed new-data grant. */
+class NrConnectedRaTestCase : public TestCase
+{
+  public:
+    NrConnectedRaTestCase() : TestCase("Connected Msg3 retains C-RNTI and retries on loss") {}
+  private:
+    /** Exercise real MAC handlers with decoded and deliberately missing Msg3 delivery. */
+    void DoRun() override
+    {
+        ConnectedRaPhy phy;
+        ConnectedRaRrc rrc;
+        auto ue=CreateObject<NrUeMac>();
+        ue->SetPhySapProvider(&phy);
+        ue->SetUeCmacSapUser(&rrc);
+        ue->m_rnti=7;
+        ue->m_connectionSuccessful=true;
+        ue->m_connectedRaPending=true;
+        auto dci=std::make_shared<DciInfoElementTdma>(9,DciInfoElementTdma::UL,
+            1,2,0,1,nullptr,20,1,0,DciInfoElementTdma::MSG3,0,0);
+        NrBuildRarListElement_s rar{};
+        rar.ulMsg3Dci=dci; rar.k2Delay=2;
+        ue->RecvRaResponse(rar,SfnSf(0,0,0,0));
+        NS_TEST_ASSERT_MSG_EQ(ue->m_rnti,7,"existing bearer identity retained");
+        NS_TEST_ASSERT_MSG_EQ(rrc.replacements,0,"RAR must not replace connected C-RNTI");
+        NS_TEST_ASSERT_MSG_EQ(rrc.successes,0,"RAR is not contention resolution");
+        NS_TEST_ASSERT_MSG_EQ(phy.identity,9,"Msg3 uses temporary physical identity");
+        NS_TEST_ASSERT_MSG_EQ(phy.packet->GetSize(),3,"C-RNTI CE is one-byte LCID plus two-byte identity");
+
+        auto gnb=CreateObject<NrGnbMac>();
+        gnb->SetPhySapProvider(&phy);
+        gnb->m_rlcAttached[9];
+        gnb->m_rlcAttached[7][1]=nullptr;
+        gnb->DoReceivePhyPdu(phy.packet->Copy());
+        NS_TEST_ASSERT_MSG_EQ(gnb->m_srRntiList.size(),1,"decoded Msg3 requests a real grant");
+        NS_TEST_ASSERT_MSG_EQ(gnb->m_srRntiList.front(),7,"scheduler receives established C-RNTI");
+        gnb->m_srRntiList.clear();
+        auto invalid=Create<Packet>(1);
+        NrMacHeaderFsUl header; header.SetLcId(NrMacHeaderFsUl::C_RNTI);
+        invalid->AddHeader(header); invalid->AddPacketTag(NrRadioBearerTag(9,58,0));
+        gnb->DoReceivePhyPdu(invalid);
+        NS_TEST_ASSERT_MSG_EQ(gnb->m_srRntiList.size(),0,"malformed CE cannot restore scheduling");
+
+        // Suppress the actual Msg3 delivery/grant. The pending procedure must
+        // time out, retain the old identity and never report false success.
+        Simulator::Stop(MilliSeconds(200)); Simulator::Run();
+        NS_TEST_ASSERT_MSG_EQ(ue->m_connectedRaPending,false,"finite resolution timeout");
+        NS_TEST_ASSERT_MSG_EQ(rrc.successes,0,"no grant means no recovery success");
+        NS_TEST_ASSERT_MSG_EQ(ue->m_rnti,7,"timeout does not destroy bearer identity");
+
+        ue->m_connectedRaPending=true;
+        auto grant=std::make_shared<DciInfoElementTdma>(7,DciInfoElementTdma::UL,
+            1,2,0,1,nullptr,20,1,0,DciInfoElementTdma::DATA,0,0);
+        ue->ProcessUlDci(Create<NrUlDciMessage>(grant));
+        NS_TEST_ASSERT_MSG_EQ(rrc.successes,1,"addressed new-data grant resolves access");
+        NS_TEST_ASSERT_MSG_EQ(ue->m_connectedRaPending,false,"resolution cancels timer");
+        ue->Dispose();gnb->Dispose();Simulator::Destroy();
+    }
+};
+
+/** Isolated connected-mode random access regression suite. */
+class NrConnectedRaTestSuite : public TestSuite
+{
+  public:
+    NrConnectedRaTestSuite() : TestSuite("nr-connected-ra",Type::UNIT)
+    { AddTestCase(new NrConnectedRaTestCase(),Duration::QUICK); }
+};
+static NrConnectedRaTestSuite g_connectedRaTestSuite;
+}

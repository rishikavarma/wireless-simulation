+    m_startSubframe = subframe;
+    m_startSlot = slot;
+    Time startDelay;
+    SfnSf startSlot(frame, subframe, slot, GetNumerology());
+    m_lastNtnOneWayDelay = GetNtnOneWayDelay();
+    if (!m_lastNtnOneWayDelay.IsZero() && HasUlSlot() && !HasDlSlot())
+    {
+        m_ntnPhaseDirection = -1;
+        const uint32_t slotsAhead = static_cast<uint32_t>(
+            std::ceil(m_lastNtnOneWayDelay.GetSeconds() / GetSlotPeriod().GetSeconds()));
+        startSlot.Add(slotsAhead);
+        startDelay = GetSlotPeriod() * slotsAhead - m_lastNtnOneWayDelay;
+    }
+    else if (!m_lastNtnOneWayDelay.IsZero() && HasDlSlot())
+    {
+        m_ntnPhaseDirection = 1;
+        startDelay = m_lastNtnOneWayDelay;
+    }
+    m_startEvent = Simulator::Schedule(startDelay, [this, nodeId, startSlot]() {
+        Simulator::ScheduleWithContext(nodeId,
+                                       Time(0),
+                                       &NrUePhy::StartEventLoop,
+                                       this,
+                                       startSlot.GetFrame(),
+                                       startSlot.GetSubframe(),
+                                       startSlot.GetSlot());
+    });
 }
 

+++ b/test/nr-spectrum-phy-power-matrix-test.cc
@@ -0,0 +1,88 @@
+// Copyright (c) 2026
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include "ns3/nr-spectrum-phy.h"
+#include "ns3/spectrum-model.h"
+#include "ns3/spectrum-signal-parameters.h"
+#include "ns3/spectrum-value.h"
+#include "ns3/test.h"
+#include "ns3/uniform-planar-array.h"
+
+namespace ns3
+{
+/** Scalar-channel fallback must preserve burst power and occupied RBs. */
+class NrSpectrumPhyPowerMatrixTestCase : public TestCase
+{
+  public:
+    NrSpectrumPhyPowerMatrixTestCase()
+        : TestCase("Fallback matrix norm equals received PSD despite later TX allocations")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        auto tx = CreateObject<NrSpectrumPhy>();
+        auto rx = CreateObject<NrSpectrumPhy>();
+        tx->SetAntenna(CreateObject<UniformPlanarArray>());
+        rx->SetAntenna(CreateObject<UniformPlanarArray>());
+        Bands bands;
+        for (uint32_t rb = 0; rb < 4; ++rb)
+        {
+            const double fc = 2e9 + rb * 180000;
+            bands.push_back({fc - 90000, fc, fc + 90000});
+        }
+        auto model = Create<SpectrumModel>(bands);
+        auto params = Create<SpectrumSignalParameters>();
+        params->txPhy = tx;
+        params->psd = Create<SpectrumValue>(model);
+        (*params->psd)[0] = 2e-20;
+        (*params->psd)[1] = 0;
+        (*params->psd)[2] = 8e-20;
+        (*params->psd)[3] = 1e-21;
+        // There need not even be a live TX PSD when a delayed burst arrives.
+        auto first = rx->CreateSpectrumChannelMatrix(params);
+        for (uint32_t iteration = 0; iteration < 16; ++iteration)
+        {
+            auto later = Create<SpectrumValue>(model);
+            for (uint32_t rb = 0; rb < 4; ++rb)
+            {
+                (*later)[rb] = iteration & (1u << rb) ? 1e-8 : 0;
+            }
+            tx->SetTxPowerSpectralDensity(later);
+            auto matrix = rx->CreateSpectrumChannelMatrix(params);
+            for (uint32_t rb = 0; rb < 4; ++rb)
+            {
+                const double power = std::norm(matrix->Elem(0, 0, rb));
+                NS_TEST_ASSERT_MSG_EQ_TOL(power, (*params->psd)[rb], 1e-32,
+                                          "matrix includes received PSD and preserves silent RBs");
+                NS_TEST_ASSERT_MSG_EQ(matrix->Elem(0, 0, rb), first->Elem(0, 0, rb),
+                                      "a later allocation cannot alter the received burst");
+            }
+        }
+        auto stronger = params->Copy();
+        stronger->psd = Copy<SpectrumValue>(params->psd);
+        *stronger->psd *= 4;
+        auto matrix = rx->CreateSpectrumChannelMatrix(stronger);
+        for (uint32_t rb = 0; rb < 4; ++rb)
+        {
+            NS_TEST_ASSERT_MSG_EQ_TOL(std::norm(matrix->Elem(0, 0, rb)),
+                                      4 * (*params->psd)[rb], 1e-31,
+                                      "received power changes reach the decoder");
+        }
+        tx->Dispose(); rx->Dispose();
+    }
+};
+
+/** Fallback single-port channel matrix regressions. */
+class NrSpectrumPhyPowerMatrixTestSuite : public TestSuite
+{
+  public:
+    NrSpectrumPhyPowerMatrixTestSuite()
+        : TestSuite("nr-spectrum-phy-power-matrix", Type::UNIT)
+    {
+        AddTestCase(new NrSpectrumPhyPowerMatrixTestCase(), Duration::QUICK);
+    }
+};
+static NrSpectrumPhyPowerMatrixTestSuite g_nrSpectrumPhyPowerMatrixTestSuite;
+} // namespace ns3

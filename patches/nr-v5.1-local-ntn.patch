+void
+NrGnbMac::FillDlTxOpportunity(NrMacSapUser* rlc,
+                               NrMacSapUser::TxOpportunityParameters params,
+                               uint32_t& used,
+                               uint32_t tbSize)
+{
+    // The scheduler reserves one maximum-size MAC subheader per LC. Every
+    // additional RLC PDU needs its own subheader, paid from this same LC budget.
+    const uint32_t maximumHeader = 3;
+    const uint32_t limit = std::min<uint64_t>(tbSize, uint64_t{used} + params.bytes + maximumHeader);
+    while (used < limit && limit - used > maximumHeader)
+    {
+        params.bytes = limit - used - maximumHeader;
+        const uint32_t before = used;
+        rlc->NotifyTxOpportunity(params);
+        NS_ABORT_MSG_IF(used < before || used > limit, "RLC exceeded its DL MAC grant");
+        if (used == before)
+        {
+            break; // Empty, window-stalled, or too small: do not spin.
+        }
+    }
+}

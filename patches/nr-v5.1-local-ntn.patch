+std::optional<uint8_t>
+NrAmc::GetMcsForSisoGrant(const SpectrumValue& sinr, uint32_t rbSymbols) const
+{
+    if (rbSymbols == 0)
+    {
+        return std::nullopt;
+    }
+    if (m_amcModel == ShannonModel)
+    {
+        uint8_t mcs = 0;
+        CreateCqiFeedbackSiso(sinr, mcs);
+        return mcs;
+    }
+    std::vector<int> rbMap;
+    for (uint32_t rb = 0; rb < sinr.GetSpectrumModel()->GetNumBands(); ++rb)
+    {
+        if (sinr[rb] > 0)
+        {
+            rbMap.push_back(rb);
+        }
+    }
+    if (rbMap.empty())
+    {
+        return std::nullopt;
+    }
+    std::optional<uint8_t> selected;
+    for (uint32_t mcs = 0; mcs <= GetMaxMcs(); ++mcs)
+    {
+        const auto bytes = CalculateTbSize(mcs, 1, rbSymbols);
+        if (bytes == 0)
+        {
+            continue;
+        }
+        const auto output = m_errorModel->GetTbDecodificationStats(sinr, rbMap, bytes,
+                                                                  mcs, {});
+        if (output->m_tbler > 0.1)
+        {
+            break;
+        }
+        selected = mcs;
+    }
+    return selected;
+}

+#include "ns3/uinteger.h"
+
+#include <algorithm>
+#include <array>
+#include <random>
+#include <sstream>
+
+namespace ns3
+{
+namespace
+{
+/** Recording scheduler demand as well as emitted PDUs. */
+class RangeCaptureMac : public NrRlcTestCaptureMac
+{
+  public:
+    void BufferStatusReport(BufferStatusReportParameters params) override
+    {
+        m_status = params;
+    }
+    BufferStatusReportParameters m_status{}; ///< Last scheduler demand
+};
+
+/** Construct identifiable, nonuniform payload bytes. */
+Ptr<Packet>
+RangePayload(uint32_t size, uint32_t identity)
+{
+    std::vector<uint8_t> bytes(size);
+    for (uint32_t i = 0; i < size; ++i)
+    {
+        bytes[i] = (identity * 131 + i * 17 + i / 251) & 255;
+    }
+    return Create<Packet>(bytes.data(), bytes.size());
+}
+
+/** Compare every delivered byte, not just packet lengths. */
+bool
+EqualPayload(Ptr<const Packet> left, Ptr<const Packet> right)
+{
+    if (left->GetSize() != right->GetSize())
+    {
+        return false;
+    }
+    std::vector<uint8_t> a(left->GetSize()), b(right->GetSize());
+    left->CopyData(a.data(), a.size());
+    right->CopyData(b.data(), b.size());
+    return a == b;
+}
+
+/** Deliver an explicitly constructed STATUS, preserving entity tags. */
+void
+RangeStatus(Ptr<NrRlcAm> tx, const NrRlcAmHeader& header)
+{
+    auto packet = Create<Packet>();
+    packet->AddHeader(header);
+    NrRlcTag tag(Simulator::Now());
+    packet->AddByteTag(tag, 1, header.GetSerializedSize());
+    DeliverPduToRlc(tx, packet);
+}
+} // namespace
+
+/** Header wire vectors, all short partition boundaries, and seeded lossy ARQ. */
+class NrRlcAmResegmentationTestCase : public TestCase
+{
+  public:
+    /** @param seed Zero selects structural tests; positive values select lossy ARQ seeds. */
+    explicit NrRlcAmResegmentationTestCase(uint32_t seed)
+        : TestCase(seed == 0 ? "AM byte-range headers, partitions, overlap, STATUS and timers"
+                             : "AM byte-exact lossy variable-grant ARQ seed " + std::to_string(seed)),
+          m_seed(seed),
+          m_rng(seed)
+    {
+    }
+
+  private:
+    void DoRun() override;
+    /// Check wire compatibility, range fields, and truncation rejection.
+    void HeaderTests();
+    /// Enumerate short payload partitions and duplicate/overlapping reception.
+    void PartitionTests();
+    /// Check missing-range feedback, grant bounds, counters, and storage.
+    void StatusTests();
+    /// Exercise maximum offsets and partial-state reestablishment.
+    void BoundaryTests();
+    void Tick();
+    void Grant(Ptr<NrRlcAm> rlc, RangeCaptureMac& mac, uint32_t size);
+    void SendCaptured(RangeCaptureMac& capture, size_t& cursor, Ptr<NrRlcAm> peer, bool status);
+    uint32_t m_seed; ///< Reproducible scenario seed
+    std::mt19937 m_rng; ///< Local independent test randomness
+    Ptr<NrRlcAm> m_tx; ///< Sender
+    Ptr<NrRlcAm> m_rx; ///< Receiver
+    RangeCaptureMac m_txMac; ///< Sender MAC capture
+    RangeCaptureMac m_rxMac; ///< Receiver MAC capture
+    NrRlcTestSduSink m_sink; ///< Received SDUs
+    std::vector<Ptr<Packet>> m_expected; ///< Original application payloads
+    size_t m_txCursor{0}; ///< Next emitted data PDU to process
+    size_t m_rxCursor{0}; ///< Next STATUS PDU to process
+    uint32_t m_ticks{0}; ///< Simulation duration bound
+    uint32_t m_dataDrops{0}; ///< Data losses injected
+    uint32_t m_statusDrops{0}; ///< Feedback losses injected
+    uint32_t m_segments{0}; ///< Retransmission segments observed
+    uint32_t m_failures{0}; ///< Maximum-retransmission indications
+    void RecordFailure() { ++m_failures; }
+    bool m_done{false}; ///< Delivered and positively acknowledged all data
+};
+
+void
+NrRlcAmResegmentationTestCase::HeaderTests()
+{
+    // Legacy whole-PDU wire vector (ACK_SN=1023, NACK_SN=1023).
+    NrRlcAmHeader legacy;
+    legacy.SetControlPdu(NrRlcAmHeader::STATUS_PDU);
+    legacy.SetAckSn(nr::SequenceNumber10(1023));
+    legacy.PushNack(1023);
+    auto packet = Create<Packet>();
+    packet->AddHeader(legacy);
+    std::array<uint8_t, 4> actual{};
+    packet->CopyData(actual.data(), actual.size());
+    const std::array<uint8_t, 4> golden{0x0f, 0xff, 0xff, 0x80};
+    NS_TEST_ASSERT_MSG_EQ(actual == golden, true, "whole-PDU wire compatibility");
+
+    for (uint32_t count = 0; count <= 64; ++count)
+    {
+        NrRlcAmHeader source;
+        source.SetControlPdu(NrRlcAmHeader::STATUS_PDU);
+        source.SetAckSn(nr::SequenceNumber10(1023));
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            const bool segmented = i % 3 != 0;
+            const uint32_t before = source.GetSerializedSize();
+            if (segmented)
+            {
+                source.PushNack(i % 2 ? 1023 : 0, i, i % 2 ? 0x7fff : i + 5);
+            }
+            else
+            {
+                source.PushNack(i % 1024);
+            }
+            NrRlcAmHeader prefix;
+            prefix.SetControlPdu(NrRlcAmHeader::STATUS_PDU);
+            prefix.SetAckSn(nr::SequenceNumber10(1023));
+            auto previous = source.GetNacks();
+            previous.pop_back();
+            for (const auto& nack : previous)
+            {
+                if (nack.segmented) prefix.PushNack(nack.sn, nack.start, nack.end);
+                else prefix.PushNack(nack.sn);
+            }
+            NS_TEST_ASSERT_MSG_EQ(prefix.GetSerializedSize(), before, "prefix size");
+            NS_TEST_ASSERT_MSG_EQ(prefix.OneMoreNackWouldFitIn(source.GetSerializedSize(), segmented),
+                                  true, "exact-fit STATUS accounting");
+            NS_TEST_ASSERT_MSG_EQ(prefix.OneMoreNackWouldFitIn(source.GetSerializedSize() - 1, segmented),
+                                  false, "one-byte-short STATUS accounting");
+        }
+        auto wire = Create<Packet>();
+        wire->AddHeader(source);
+        NrRlcAmHeader decoded;
+        NS_TEST_ASSERT_MSG_EQ(wire->PeekHeader(decoded), source.GetSerializedSize(), "header size");
+        NS_TEST_ASSERT_MSG_EQ(decoded.GetNacks().size(), count, "all NACK entries round trip");
+        auto expected = source.GetNacks().begin();
+        for (const auto& nack : decoded.GetNacks())
+        {
+            NS_TEST_ASSERT_MSG_EQ(nack.sn, expected->sn, "NACK SN");
+            NS_TEST_ASSERT_MSG_EQ(nack.segmented, expected->segmented, "E2");
+            NS_TEST_ASSERT_MSG_EQ(nack.start, expected->start, "SOstart");
+            NS_TEST_ASSERT_MSG_EQ(nack.end, expected->end, "SOend");
+            ++expected;
+        }
+        wire->PeekHeader(decoded);
+        NS_TEST_ASSERT_MSG_EQ(decoded.GetNacks().size(), count, "reusing a header clears old entries");
+        for (uint32_t length = 0; length < source.GetSerializedSize(); ++length)
+        {
+            auto truncated = wire->CreateFragment(0, length);
+            NrRlcAmHeader invalid;
+            NS_TEST_ASSERT_MSG_EQ(truncated->PeekHeader(invalid), 0, "truncated STATUS rejected");
+        }
+    }
+}
+
+void
+NrRlcAmResegmentationTestCase::PartitionTests()
+{
+    // Enumerate every two-way split and overlap of short payloads. End fragments
+    // arrive first, with duplicates; no delivery is allowed before complete coverage.
+    for (uint32_t size = 2; size <= 24; ++size)
+    {
+        for (uint32_t split = 1; split < size; ++split)
+        {
+            for (uint32_t overlap = 0; overlap <= std::min(split, size - split); ++overlap)
+            {
+                auto tx = CreateObject<NrRlcAm>();
+                auto rx = CreateObject<NrRlcAm>();
+                RangeCaptureMac txMac, rxMac;
+                NrRlcTestSduSink sink;
+                tx->SetNrMacSapProvider(&txMac);
+                rx->SetNrMacSapProvider(&rxMac);
+                rx->SetNrRlcSapUser(sink.GetSapUser());
+                auto expected = RangePayload(size, split);
+                tx->DoTransmitPdcpPdu(expected->Copy());
+                GrantTxOpportunities(tx, std::max(7u, size + 4), 1);
+                NS_TEST_ASSERT_MSG_EQ(txMac.m_pdus.size(), 1, "one canonical PDU");
+                auto tail = tx->MakeFragment(txMac.m_pdus[0], split, size, false);
+                DeliverPduToRlc(rx, tail);
+                DeliverPduToRlc(rx, tail);
+                NS_TEST_ASSERT_MSG_EQ(sink.m_sdus.size(), 0, "tail is incomplete");
+                auto head = tx->MakeFragment(txMac.m_pdus[0], 0, split + overlap, false);
+                DeliverPduToRlc(rx, head);
+                DeliverPduToRlc(rx, head);
+                NS_TEST_ASSERT_MSG_EQ(sink.m_sdus.size(), 1, "complete SDU delivered exactly once");
+                NS_TEST_ASSERT_MSG_EQ(EqualPayload(sink.m_sdus[0], expected), true,
+                                      "byte-exact overlapping reassembly");
+                NS_TEST_ASSERT_MSG_EQ(rx->m_rxonBuffer.empty(), true, "completed storage released");
+                tx->Dispose(); rx->Dispose();
+                Simulator::Destroy();
+            }
+        }
+    }
+}
+
+void
+NrRlcAmResegmentationTestCase::StatusTests()
+{
+    auto tx = CreateObject<NrRlcAm>();
+    auto rx = CreateObject<NrRlcAm>();
+    RangeCaptureMac txMac, rxMac;
+    NrRlcTestSduSink sink;
+    tx->SetNrMacSapProvider(&txMac);
+    rx->SetNrMacSapProvider(&rxMac);
+    rx->SetNrRlcSapUser(sink.GetSapUser());
+    // Three SDUs cross retransmission cuts and LI extension-byte boundaries.
+    for (uint32_t n : {37u, 91u, 172u}) tx->DoTransmitPdcpPdu(RangePayload(n, n));
+    GrantTxOpportunities(tx, 400, 1);
+    auto original = txMac.m_pdus.front();
+    auto payload = original->Copy(); NrRlcAmHeader h; payload->RemoveHeader(h);
+    NS_TEST_ASSERT_MSG_EQ(payload->GetSize(), 300, "canonical concatenation");
+    DeliverPduToRlc(rx, tx->MakeFragment(original, 0, 40, false));
+    DeliverPduToRlc(rx, tx->MakeFragment(original, 60, 130, false));
+    DeliverPduToRlc(rx, tx->MakeFragment(original, 200, 300, false));
+    rx->m_vrMs = 1;
+    rx->m_statusPduRequested = true;
+    rx->m_statusPduBufferSize = 4;
+    GrantTxOpportunities(rx, 32, 1);
+    NrRlcAmHeader status; rxMac.m_pdus.back()->PeekHeader(status);
+    NS_TEST_ASSERT_MSG_EQ(status.GetNacks().size(), 2, "two explicit holes");
+    auto hole = status.GetNacks().begin();
+    NS_TEST_ASSERT_MSG_EQ(hole->start, 40, "first hole start");
+    NS_TEST_ASSERT_MSG_EQ(hole->end, 59, "first hole inclusive end");
+    ++hole;
+    NS_TEST_ASSERT_MSG_EQ(hole->start, 130, "second hole start");
+    NS_TEST_ASSERT_MSG_EQ(hole->end, 199, "second hole inclusive end");
+    RangeStatus(tx, status);
+    NS_TEST_ASSERT_MSG_EQ(tx->m_retxBuffer[0].m_pending.size(), 2, "only missing ranges queued");
+    NS_TEST_ASSERT_MSG_EQ(tx->m_retxBuffer[0].m_retxCount, 0, "first recovery round");
+    RangeStatus(tx, status);
+    NS_TEST_ASSERT_MSG_EQ(tx->m_retxBuffer[0].m_retxCount, 0, "duplicate NACK is not a retry round");
+    NS_TEST_ASSERT_MSG_EQ(tx->m_retxBuffer[0].m_pending.size(), 2, "duplicate ranges merged");
+    uint32_t attempts = 0;
+    while (tx->m_retxBufferSize && attempts++ < 100)
+    {
+        const size_t before = txMac.m_pdus.size();
+        GrantTxOpportunities(tx, 9, 1);
+        NS_TEST_ASSERT_MSG_EQ(txMac.m_pdus.size(), before + 1, "small grants make progress");
+        NS_TEST_ASSERT_MSG_LT_OR_EQ(txMac.m_pdus.back()->GetSize(), 9, "grant respected");
+        DeliverPduToRlc(rx, txMac.m_pdus.back());
+        NS_TEST_ASSERT_MSG_EQ(tx->m_txedBufferSize + tx->m_retxBufferSize, original->GetSize(),
+                              "one retained canonical original, despite many fragments");
+    }
+    NS_TEST_ASSERT_MSG_EQ(tx->m_txedBuffer[0].m_retxCount, 0, "fragments do not exhaust retry count");
+    NS_TEST_ASSERT_MSG_EQ(sink.m_sdus.size(), 3, "all concatenated SDUs recovered");
+    for (uint32_t i = 0; i < 3; ++i)
+    {
+        const uint32_t sizes[] = {37, 91, 172};
+        NS_TEST_ASSERT_MSG_EQ(EqualPayload(sink.m_sdus[i], RangePayload(sizes[i], sizes[i])), true,
+                              "SDU boundaries preserved across fragment cuts");
+    }
+    tx->SetMaxRetxReachedCallback(MakeCallback(&NrRlcAmResegmentationTestCase::RecordFailure, this));
+    NrRlcAmHeader retry; retry.SetControlPdu(NrRlcAmHeader::STATUS_PDU);
+    retry.SetAckSn(nr::SequenceNumber10(1)); retry.PushNack(0);
+    for (uint32_t round = 1; round <= 7; ++round)
+    {
+        RangeStatus(tx, retry);
+        uint32_t pieces = 0;
+        while (tx->m_retxBufferSize && pieces++ < 400)
+        {
+            const size_t before = txMac.m_pdus.size();
+            GrantTxOpportunities(tx, 5, 1);
+            NS_TEST_ASSERT_MSG_EQ(txMac.m_pdus.size(), before + 1, "one-byte grants progress");
+            NS_TEST_ASSERT_MSG_LT_OR_EQ(txMac.m_pdus.back()->GetSize(), 5, "one-byte payload fits");
+        }
+        NS_TEST_ASSERT_MSG_EQ(tx->m_txedBuffer[0].m_retxCount, round, "retry counts recovery rounds");
+    }
+    Simulator::Stop(NanoSeconds(1)); Simulator::Run();
+    NS_TEST_ASSERT_MSG_EQ(m_failures, 1, "max-retry indication fires once, not per fragment");
+    NrRlcAmHeader ack; ack.SetControlPdu(NrRlcAmHeader::STATUS_PDU);
+    ack.SetAckSn(nr::SequenceNumber10(1)); RangeStatus(tx, ack);
+    NS_TEST_ASSERT_MSG_EQ(tx->m_txedBufferSize + tx->m_retxBufferSize, 0, "ACK releases originals");
+    NS_TEST_ASSERT_MSG_EQ(txMac.m_status.retxQueueSize, 0, "ACK clears scheduler demand");
+    tx->Dispose(); rx->Dispose(); Simulator::Destroy();
+
+    // A tiny STATUS must fall back to whole-SN NACKs, not acknowledge omitted holes.
+    for (uint32_t grant : {4u, 5u, 6u, 7u, 8u, 9u, 10u, 16u})
+    {
+        auto a = CreateObject<NrRlcAm>(); auto b = CreateObject<NrRlcAm>();
+        RangeCaptureMac am, bm; NrRlcTestSduSink output;
+        a->SetNrMacSapProvider(&am); b->SetNrMacSapProvider(&bm);
+        b->SetNrRlcSapUser(output.GetSapUser());
+        a->DoTransmitPdcpPdu(RangePayload(100, 99)); GrantTxOpportunities(a, 104, 1);
+        DeliverPduToRlc(b, a->MakeFragment(am.m_pdus[0], 20, 40, false));
+        DeliverPduToRlc(b, a->MakeFragment(am.m_pdus[0], 60, 80, false));
+        b->m_vrMs = 1; b->m_statusPduRequested = true; b->m_statusPduBufferSize = 4;
+        GrantTxOpportunities(b, grant, 1);
+        NrRlcAmHeader small; bm.m_pdus.back()->PeekHeader(small);
+        NS_TEST_ASSERT_MSG_LT_OR_EQ(bm.m_pdus.back()->GetSize(), grant, "STATUS fits grant");
+        NS_TEST_ASSERT_MSG_EQ(small.IsNackPresent(nr::SequenceNumber10(0)), true,
+                              "all incomplete data remains NACKed");
+        if (small.GetNacks().size() == 1)
+        {
+            NS_TEST_ASSERT_MSG_EQ(small.GetNacks().front().segmented, false,
+                                  "partial hole list uses whole-PDU fallback");
+        }
+        a->Dispose(); b->Dispose(); Simulator::Destroy();
+    }
+}
+
+void
+NrRlcAmResegmentationTestCase::BoundaryTests()
+{
+    auto tx = CreateObject<NrRlcAm>(); auto rx = CreateObject<NrRlcAm>();
+    RangeCaptureMac txMac, rxMac; NrRlcTestSduSink sink;
+    tx->SetNrMacSapProvider(&txMac); rx->SetNrMacSapProvider(&rxMac);
+    rx->SetNrRlcSapUser(sink.GetSapUser());
+    tx->SetAttribute("MaxTxBufferSize", UintegerValue(0));
+    auto expected = RangePayload(32768, 77);
+    tx->DoTransmitPdcpPdu(expected->Copy()); GrantTxOpportunities(tx, 32772, 1);
+    auto original = txMac.m_pdus.front();
+    auto tail = tx->MakeFragment(original, 32767, 32768, false);
+    NrRlcAmHeader h; tail->PeekHeader(h);
+    NS_TEST_ASSERT_MSG_EQ(h.GetSegmentOffset(), 32767, "maximum representable offset");
+    NS_TEST_ASSERT_MSG_EQ(h.GetLastOffset(), 32768, "exclusive end does not wrap");
+    DeliverPduToRlc(rx, tail);
+    NS_TEST_ASSERT_MSG_EQ(sink.m_sdus.size(), 0, "last segment does not imply complete coverage");
+    DeliverPduToRlc(rx, tx->MakeFragment(original, 0, 32767, false));
+    NS_TEST_ASSERT_MSG_EQ(sink.m_sdus.size(), 1, "full 15-bit offset space reassembled");
+    NS_TEST_ASSERT_MSG_EQ(EqualPayload(sink.m_sdus[0], expected), true, "maximum-offset data integrity");
+    tx->Dispose(); rx->Dispose(); Simulator::Destroy();
+
+    // A peer entity replacement must discard partial byte ranges from the old
+    // epoch, and a delayed old fragment must not attach to the new SN zero.
+    auto oldTx = CreateObject<NrRlcAm>(); auto newTx = CreateObject<NrRlcAm>();
+    auto receiver = CreateObject<NrRlcAm>();
+    RangeCaptureMac oldMac, newMac, receiverMac; NrRlcTestSduSink output;
+    oldTx->SetNrMacSapProvider(&oldMac); newTx->SetNrMacSapProvider(&newMac);
+    receiver->SetNrMacSapProvider(&receiverMac); receiver->SetNrRlcSapUser(output.GetSapUser());
+    oldTx->DoTransmitPdcpPdu(RangePayload(100, 1)); GrantTxOpportunities(oldTx, 104, 1);
+    DeliverPduToRlc(receiver, oldTx->MakeFragment(oldMac.m_pdus[0], 0, 50, false));
+    NS_TEST_ASSERT_MSG_EQ(receiver->m_rxonBuffer.size(), 1, "old partial state retained before reset");
+    auto fresh = RangePayload(50, 2);
+    newTx->DoTransmitPdcpPdu(fresh->Copy()); GrantTxOpportunities(newTx, 54, 1);
+    DeliverPduToRlc(receiver, newMac.m_pdus[0]);
+    DeliverPduToRlc(receiver, oldTx->MakeFragment(oldMac.m_pdus[0], 50, 100, false));
+    NS_TEST_ASSERT_MSG_EQ(output.m_sdus.size(), 1, "late old-epoch fragment cannot create a delivery");
+    NS_TEST_ASSERT_MSG_EQ(EqualPayload(output.m_sdus[0], fresh), true, "new epoch is not contaminated");
+    NS_TEST_ASSERT_MSG_EQ(receiver->m_rxonBuffer.empty(), true, "partial state cleared on reestablishment");
+    oldTx->Dispose(); newTx->Dispose(); receiver->Dispose(); Simulator::Destroy();
+}
+
+void
+NrRlcAmResegmentationTestCase::Grant(Ptr<NrRlcAm> rlc, RangeCaptureMac& mac, uint32_t size)
+{
+    const size_t before = mac.m_pdus.size();
+    GrantTxOpportunities(rlc, size, 1);
+    for (size_t i = before; i < mac.m_pdus.size(); ++i)
+    {
+        NS_TEST_ASSERT_MSG_LT_OR_EQ(mac.m_pdus[i]->GetSize(), size, "every PDU fits actual grant");
+    }
+}
+
+void
+NrRlcAmResegmentationTestCase::SendCaptured(RangeCaptureMac& capture, size_t& cursor,
+                                          Ptr<NrRlcAm> peer, bool status)
+{
+    while (cursor < capture.m_pdus.size())
+    {
+        auto packet = capture.m_pdus[cursor++];
+        NrRlcAmHeader header; packet->PeekHeader(header);
+        if (header.IsDataPdu() && header.GetResegmentationFlag() == NrRlcAmHeader::SEGMENT)
+        {
+            ++m_segments;
+        }
+        bool drop = m_rng() % 100 < (status ? 25u : 22u);
+        // Force feedback outage, so poll expiry and resegmentation are exercised.
+        drop = drop || (status && Simulator::Now() < MilliSeconds(350));
+        if (drop)
+        {
+            if (status) ++m_statusDrops; else ++m_dataDrops;
+            continue;
+        }
+        const auto delay = MilliSeconds(15 + m_rng() % 36);
+        Simulator::Schedule(delay, [peer, packet]() { DeliverPduToRlc(peer, packet); });
+        if (m_rng() % 5 == 0)
+        {
+            Simulator::Schedule(delay + MilliSeconds(1 + m_rng() % 20),
+                                [peer, packet]() { DeliverPduToRlc(peer, packet); });
+        }
+    }
+}
+
+void
+NrRlcAmResegmentationTestCase::Tick()
+{
+    ++m_ticks;
+    const uint32_t grant = m_ticks == 1 ? 4096
+                           : m_ticks % 13 < 3 ? m_ticks % 5 : 5 + m_rng() % 190;
+    Grant(m_tx, m_txMac, grant);
+    SendCaptured(m_txMac, m_txCursor, m_rx, false);
+    if (m_rxMac.m_status.statusPduSize)
+    {
+        Grant(m_rx, m_rxMac, 4 + m_rng() % 32);
+    }
+    SendCaptured(m_rxMac, m_rxCursor, m_tx, true);
+    if (m_sink.m_sdus.size() == m_expected.size() && m_tx->m_vtA == m_tx->m_vtS &&
+        m_tx->m_txonBufferSize + m_tx->m_retxBufferSize + m_tx->m_txedBufferSize == 0)
+    {
+        m_done = true;
+        Simulator::Stop();
+    }
+    else if (m_ticks < 12000)
+    {
+        Simulator::Schedule(MilliSeconds(1), &NrRlcAmResegmentationTestCase::Tick, this);
+    }
+    else
+    {
+        Simulator::Stop();
+    }
+}
+
+void
+NrRlcAmResegmentationTestCase::DoRun()
+{
+    if (m_seed == 0)
+    {
+        HeaderTests(); PartitionTests(); StatusTests(); BoundaryTests();
+        return;
+    }
+    m_tx = CreateObject<NrRlcAm>(); m_rx = CreateObject<NrRlcAm>();
+    m_tx->SetNrMacSapProvider(&m_txMac); m_rx->SetNrMacSapProvider(&m_rxMac);
+    m_rx->SetNrRlcSapUser(m_sink.GetSapUser());
+    m_tx->SetAttribute("MaxTxBufferSize", UintegerValue(0));
+    m_tx->SetAttribute("TxOpportunityForRetxAlwaysBigEnough", BooleanValue(m_seed % 128 == 0));
+    m_tx->SetAttribute("MaxDataFieldBytes", UintegerValue(m_seed % 2 ? 0 : 120));
+    m_tx->SetAttribute("PollRetransmitTimer", TimeValue(MilliSeconds(200)));
+    m_rx->SetAttribute("ReorderingTimer", TimeValue(MilliSeconds(80)));
+    m_rx->SetAttribute("StatusProhibitTimer", TimeValue(MilliSeconds(5)));
+    // Begin near wraparound; more than one SN epoch is exercised by small grants.
+    const uint16_t start = m_seed % 3 == 0 ? 1018 : 0;
+    m_tx->m_vtA = start; m_tx->m_vtS = start; m_tx->m_vtMs = m_tx->m_vtA + 512;
+    m_rx->m_vrR = start; m_rx->m_vrMs = start; m_rx->m_vrH = start; m_rx->m_vrX = start;
+    m_rx->m_vrMr = m_rx->m_vrR + 512; m_rx->m_expectedSeqNumber = start;
+    m_tx->m_vtA.SetModulusBase(m_tx->m_vtA);
+    m_tx->m_vtS.SetModulusBase(m_tx->m_vtA);
+    m_tx->m_vtMs.SetModulusBase(m_tx->m_vtA);
+    m_rx->m_vrR.SetModulusBase(m_rx->m_vrR);
+    m_rx->m_vrMs.SetModulusBase(m_rx->m_vrR);
+    m_rx->m_vrH.SetModulusBase(m_rx->m_vrR);
+    m_rx->m_vrX.SetModulusBase(m_rx->m_vrR);
+    m_rx->m_vrMr.SetModulusBase(m_rx->m_vrR);
+    const uint32_t sdus = m_seed % 64 == 0 ? 1800 : 32;
+    for (uint32_t i = 0; i < sdus; ++i)
+    {
+        auto packet = RangePayload(20 + m_rng() % (sdus > 32 ? 60 : 700), i);
+        m_expected.push_back(packet->Copy());
+        m_tx->DoTransmitPdcpPdu(packet);
+    }
+    Simulator::ScheduleNow(&NrRlcAmResegmentationTestCase::Tick, this);
+    Simulator::Run();
+    NS_TEST_ASSERT_MSG_EQ(m_done, true, "lossy ARQ must drain within bounded time; seed " << m_seed);
+    NS_TEST_ASSERT_MSG_EQ(m_sink.m_sdus.size(), m_expected.size(), "all SDUs delivered once");
+    for (size_t i = 0; i < std::min(m_sink.m_sdus.size(), m_expected.size()); ++i)
+    {
+        NS_TEST_ASSERT_MSG_EQ(EqualPayload(m_sink.m_sdus[i], m_expected[i]), true,
+                              "byte-exact in-order SDU " << i << " seed " << m_seed);
+    }
+    NS_TEST_ASSERT_MSG_GT(m_dataDrops, 0, "loss injection active");
+    NS_TEST_ASSERT_MSG_GT(m_statusDrops, 0, "feedback loss injection active");
+    NS_TEST_ASSERT_MSG_GT(m_segments, 0, "resegmentation exercised");
+    NS_TEST_ASSERT_MSG_EQ(m_tx->m_txedBufferSize + m_tx->m_retxBufferSize, 0, "retained state drains");
+    m_tx->Dispose(); m_rx->Dispose(); Simulator::Destroy();
+    // TestCase instances live until the whole suite exits. Release packet graphs
+    // after each seed so extensive sanitizer runs have bounded live storage.
+    m_txMac.m_pdus.clear(); m_rxMac.m_pdus.clear();
+    m_expected.clear(); m_sink.m_sdus.clear();
+    m_tx = nullptr; m_rx = nullptr;
+}
+
+/** AM retransmission resegmentation and data-integrity regressions. */
+class NrRlcAmResegmentationTestSuite : public TestSuite
+{
+  public:
+    NrRlcAmResegmentationTestSuite()
+        : TestSuite("nr-test-rlc-am-resegmentation", Type::SYSTEM)
+    {
+        AddTestCase(new NrRlcAmResegmentationTestCase(0), Duration::QUICK);
+        for (uint32_t seed = 1; seed <= 1024; ++seed)
+        {
+            AddTestCase(new NrRlcAmResegmentationTestCase(seed),
+                        seed <= 64 ? Duration::QUICK : Duration::EXTENSIVE);
+        }
+    }
+};

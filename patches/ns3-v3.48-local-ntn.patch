+/**
+ * @ingroup internet-test
+ * @brief Check timestamp echoes over delayed and piggybacked acknowledgements.
+ */
+class TimestampEchoTestCase : public TestCase
+{
+  public:
+    /**
+     * @param piggyback Reply with data before the delayed-ACK timer expires.
+     */
+    explicit TimestampEchoTestCase(bool piggyback)
+        : TestCase(piggyback ? "Timestamp advances after piggybacked ACKs"
+                            : "Delayed ACK echoes the earliest unacknowledged timestamp"),
+          m_piggyback(piggyback)
+    {
+    }
+
+  private:
+    void DoRun() override;
+    void DoTeardown() override;
+    /**
+     * Accept the established connection and attach packet observers.
+     * @param socket Accepted socket.
+     * @param from Remote address.
+     */
+    void Accept(Ptr<Socket> socket, const Address& from);
+    /**
+     * Drain received bytes and schedule application replies when enabled.
+     * @param socket Socket with readable data.
+     */
+    void Receive(Ptr<Socket> socket);
+    /** Send one request, separated from other requests in simulation time. */
+    void SendRequest();
+    /** Send a response carrying the acknowledgement of the latest request. */
+    void SendReply();
+    /**
+     * Remember timestamps from newly received data packets.
+     * @param packet Received payload.
+     * @param header Received TCP header.
+     * @param socket Receiving socket.
+     */
+    void Rx(Ptr<const Packet> packet, const TcpHeader& header, Ptr<const TcpSocketBase> socket);
+    /**
+     * Check the timestamp echoed in each acknowledgement.
+     * @param packet Transmitted payload.
+     * @param header Transmitted TCP header.
+     * @param socket Transmitting socket.
+     */
+    void Tx(Ptr<const Packet> packet, const TcpHeader& header, Ptr<const TcpSocketBase> socket);
+
+    bool m_piggyback;                          //!< Exercise bidirectional application traffic.
+    Ptr<Socket> m_listener;                    //!< Listening socket.
+    Ptr<Socket> m_sender;                      //!< Request sender.
+    Ptr<Socket> m_receiver;                    //!< Accepted connection.
+    std::vector<uint32_t> m_pendingTimestamps; //!< Data timestamps not yet acknowledged.
+    uint32_t m_receivedPackets{0};             //!< Data packets observed at the receiver.
+    uint32_t m_ackPackets{0};                  //!< Acknowledgements checked.
+    uint32_t m_piggybackPackets{0};             //!< Data-carrying acknowledgements checked.
+};
+
+void
+TimestampEchoTestCase::DoRun()
+{
+    NodeContainer nodes;
+    nodes.Create(2);
+    InternetStackHelper internet;
+    internet.Install(nodes);
+    auto channel = CreateObject<SimpleChannel>();
+    channel->SetAttribute("Delay", TimeValue(MilliSeconds(10)));
+    SimpleNetDeviceHelper link;
+    link.SetNetDevicePointToPointMode(true);
+    auto devices = link.Install(nodes, channel);
+    Ipv4AddressHelper addresses;
+    addresses.SetBase("10.1.1.0", "255.255.255.0");
+    auto interfaces = addresses.Assign(devices);
+
+    m_listener = Socket::CreateSocket(nodes.Get(1), TcpSocketFactory::GetTypeId());
+    m_sender = Socket::CreateSocket(nodes.Get(0), TcpSocketFactory::GetTypeId());
+    for (auto socket : {m_listener, m_sender})
+    {
+        socket->SetAttribute("Timestamp", BooleanValue(true));
+        socket->SetAttribute("TcpNoDelay", BooleanValue(true));
+        socket->SetAttribute("SegmentSize", UintegerValue(512));
+        socket->SetAttribute("InitialCwnd", UintegerValue(10));
+        socket->SetAttribute("DelAckCount", UintegerValue(2));
+        socket->SetAttribute("DelAckTimeout", TimeValue(MilliSeconds(200)));
+    }
+    m_listener->SetAcceptCallback(MakeNullCallback<bool, Ptr<Socket>, const Address&>(),
+                                 MakeCallback(&TimestampEchoTestCase::Accept, this));
+    m_listener->Bind(InetSocketAddress(Ipv4Address::GetAny(), 4477));
+    m_listener->Listen();
+    m_sender->SetRecvCallback(MakeCallback(&TimestampEchoTestCase::Receive, this));
+    m_sender->Bind();
+    Simulator::ScheduleNow(
+        [this, address = InetSocketAddress(interfaces.GetAddress(1), 4477)]() {
+            m_sender->Connect(address);
+        });
+    if (m_piggyback)
+    {
+        for (uint32_t i = 0; i < 6; ++i)
+        {
+            Simulator::Schedule(MilliSeconds(1000 + 300 * i),
+                                &TimestampEchoTestCase::SendRequest,
+                                this);
+        }
+    }
+    else
+    {
+        // Prime the connection so handshake ACK state cannot split the first pair.
+        for (const auto t : {500, 1000, 1050, 1500, 1550})
+        {
+            Simulator::Schedule(MilliSeconds(t), &TimestampEchoTestCase::SendRequest, this);
+        }
+    }
+    Simulator::Stop(Seconds(3.5));
+    Simulator::Run();
+    NS_TEST_ASSERT_MSG_EQ(m_receivedPackets, m_piggyback ? 6 : 5, "Missing request packets");
+    NS_TEST_ASSERT_MSG_EQ(m_ackPackets, m_piggyback ? 6 : 3, "Missing acknowledgements");
+    NS_TEST_ASSERT_MSG_EQ(m_piggybackPackets,
+                          m_piggyback ? 6 : 0,
+                          "Requests must receive data-carrying acknowledgements");
+    NS_TEST_ASSERT_MSG_EQ(m_pendingTimestamps.empty(), true, "Unacknowledged data at test end");
+}
+
+void
+TimestampEchoTestCase::DoTeardown()
+{
+    Simulator::Destroy();
+    m_listener = nullptr;
+    m_sender = nullptr;
+    m_receiver = nullptr;
+}
+
+void
+TimestampEchoTestCase::Accept(Ptr<Socket> socket, const Address& /*from*/)
+{
+    m_receiver = socket;
+    socket->SetRecvCallback(MakeCallback(&TimestampEchoTestCase::Receive, this));
+    socket->TraceConnectWithoutContext("Rx", MakeCallback(&TimestampEchoTestCase::Rx, this));
+    socket->TraceConnectWithoutContext("Tx", MakeCallback(&TimestampEchoTestCase::Tx, this));
+}
+
+void
+TimestampEchoTestCase::Receive(Ptr<Socket> socket)
+{
+    while (auto packet = socket->Recv())
+    {
+        if (packet->GetSize() == 0)
+        {
+            break;
+        }
+        if (m_piggyback && socket == m_receiver)
+        {
+            Simulator::Schedule(MilliSeconds(10), &TimestampEchoTestCase::SendReply, this);
+        }
+    }
+}
+
+void
+TimestampEchoTestCase::SendRequest()
+{
+    NS_TEST_ASSERT_MSG_EQ(m_sender->Send(Create<Packet>(512)), 512, "Request send failed");
+}
+
+void
+TimestampEchoTestCase::SendReply()
+{
+    NS_TEST_ASSERT_MSG_EQ(m_receiver->Send(Create<Packet>(32)), 32, "Reply send failed");
+}
+
+void
+TimestampEchoTestCase::Rx(Ptr<const Packet> packet,
+                         const TcpHeader& header,
+                         Ptr<const TcpSocketBase> /*socket*/)
+{
+    if (packet->GetSize() > 0)
+    {
+        auto timestamp = DynamicCast<const TcpOptionTS>(header.GetOption(TcpOption::TS));
+        NS_TEST_ASSERT_MSG_NE(timestamp, nullptr, "Request lacks negotiated timestamps");
+        m_pendingTimestamps.push_back(timestamp->GetTimestamp());
+        ++m_receivedPackets;
+    }
+}
+
+void
+TimestampEchoTestCase::Tx(Ptr<const Packet> packet,
+                         const TcpHeader& header,
+                         Ptr<const TcpSocketBase> /*socket*/)
+{
+    if ((header.GetFlags() & TcpHeader::SYN) || !(header.GetFlags() & TcpHeader::ACK))
+    {
+        return;
+    }
+    if (m_piggyback && packet->GetSize() == 0)
+    {
+        // The first request can trigger an immediate ACK from handshake state.
+        // Subsequent requests must be acknowledged only by application replies.
+        NS_TEST_ASSERT_MSG_EQ(m_piggybackPackets, 0, "Unexpected pure ACK after the first reply");
+        return;
+    }
+    NS_TEST_ASSERT_MSG_EQ(m_pendingTimestamps.size(),
+                          m_piggyback || m_ackPackets == 0 ? 1 : 2,
+                          "ACK must cover the intended data packets");
+    auto timestamp = DynamicCast<const TcpOptionTS>(header.GetOption(TcpOption::TS));
+    NS_TEST_ASSERT_MSG_NE(timestamp, nullptr, "ACK lacks negotiated timestamps");
+    NS_TEST_ASSERT_MSG_EQ(timestamp->GetEcho(),
+                          m_pendingTimestamps.front(),
+                          "Echo must retain the earliest timestamp until data is acknowledged");
+    m_pendingTimestamps.clear();
+    ++m_ackPackets;
+    if (packet->GetSize() > 0)
+    {
+        ++m_piggybackPackets;
+    }
+}

+/**
+ * Expand the MAC-48 type prefix in a golden cache dump. Address type identifiers
+ * depend on registration order, including which modules are linked into the runner.
+ * Keep the type, length, address bytes, cache entries and ordering checks exact.
+ * @param expected Golden dump using the historical MAC-48 type identifier
+ * @return Golden dump using the current MAC-48 type identifier
+ */
+std::string
+WithMac48AddressType(std::string expected)
+{
+    std::ostringstream formatted;
+    formatted << Address(Mac48Address("00:00:00:00:00:00"));
+    const std::string prefix = formatted.str().substr(0, 6);
+    const std::string historical = "03-06-";
+    for (auto pos = expected.find(historical); pos != std::string::npos;
+         pos = expected.find(historical, pos + prefix.size()))
+    {
+        expected.replace(pos, historical.size(), prefix);
+    }
+    return expected;
+}
